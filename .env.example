# Telegram BotFather dan olingan bot tokeni (Majburiy)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Ruxsat etilgan maksimal audio fayl hajmi (MB da). Telegram standart bot limiti 50 MB
MAX_AUDIO_SIZE_MB=50

# Videodan audio yuklab olish uchun timeout vaqti (soniyalarda)
DOWNLOAD_TIMEOUT_SECONDS=120

# Shazam orqali qidirish uchun timeout vaqti (soniyalarda)
RECOGNITION_TIMEOUT_SECONDS=30

# Logging darajasi (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
